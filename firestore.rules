rules_version = '2';

// Firestore security rules for buddyworkout-fb309.
//
// Scope: the `users/{uid}` document only. The challenge, participant and
// session rules sketched in docs/architecture/02-firebase-design.md §7 land
// with the challenge slice — writing them now would be untested guesswork
// against collections nothing reads or writes yet.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    match /users/{uid} {
      // Buddy lists and leaderboards show other people's names and avatars, so
      // a profile is readable by any signed-in user — never publicly.
      allow read: if isSignedIn();

      // Only the owner writes their own profile. `activeChallengeCount` becomes
      // server-only once Functions maintain it; today nothing increments it.
      allow write: if isSignedIn() && request.auth.uid == uid;

      match /buddies/{buddyUid} {
        allow read, write: if isSignedIn() && request.auth.uid == uid;
      }
    }

    // Anything not named above is denied. Collections arriving with later
    // slices must add their own rules rather than rely on a default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
