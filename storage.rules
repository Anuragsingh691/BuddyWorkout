rules_version = '2';

// Cloud Storage is not used by this app.
//
// Avatars are Firestore Blobs at users/{uid}/media/avatar — a new Firebase
// project needs the Blaze plan before it gets a Storage bucket at all, and one
// 40KB avatar does not justify that. Workout video is never uploaded either,
// by design: frames are counted on-device and only the rep total is stored.
//
// These rules stay deny-all so that if a bucket is ever provisioned, nothing
// can quietly start writing to it without a deliberate change here.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
